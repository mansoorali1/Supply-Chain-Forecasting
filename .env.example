# .env.example
# Copy this file to .env and fill in your values
# Never commit the actual .env file

# MLflow
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=supply_chain_forecasting

# DVC remote (Google Drive folder ID)
DVC_GDRIVE_FOLDER_ID=your_google_drive_folder_id_here

# App configuration
APP_ENV=development
LOG_LEVEL=INFO
