models/
*.pkl
*.h5
*.joblib

# MLflow
mlruns/
mlartifacts/

# Environment
.env
*.env
.env.local

# DVC internal files (the .dvc pointer files ARE committed to git)
/tmp

# OS
.DS_Store
Thumbs.db
desktop.ini

